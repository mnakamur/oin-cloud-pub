{
  "lambdaLayers": [
    {
      "type": "ProjectLayer",
      "resourceName": "pdfvueampprjshomeiFlowLayer",
      "version": "Always choose latest version",
      "isLatestVersionSelected": true,
      "env": "main"
    }
  ],
  "permissions": {
    "api": {
      "pdfvueampprj": [
        "Query",
        "Mutation"
      ]
    },
    "storage": {
      "amplifyvuepdf": [
        "read",
        "update"
      ],
      "bunsyo:@model(appsync)": [
        "read",
        "update"
      ],
      "Shomei:@model(appsync)": [
        "read",
        "update"
      ]
    }
  },
  "environmentVariableList": [
    {
      "cloudFormationParameterName": "iamAccessKeyId",
      "environmentVariableName": "IAM_ACCESS_KEY_ID"
    },
    {
      "cloudFormationParameterName": "iamSecretAccessKey",
      "environmentVariableName": "IAM_SECRET_ACCESS_KEY"
    },
    {
      "cloudFormationParameterName": "contactinfoMail",
      "environmentVariableName": "CONTACTINFO_MAIL"
    },
    {
      "cloudFormationParameterName": "siteUrl",
      "environmentVariableName": "SITE_URL"
    }
  ]
}